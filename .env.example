# Hair Studio 360: documentation only. Configure Render manually.
SECRET_KEY=replace-with-a-new-random-session-secret
APP_KEY=replace-with-new-hair-studio-360-app-key
APP_SLUG=hair-studio-360
ADMIN_URL=https://admin.flowgeniq.io
SUITE_URL=https://suite.flowmediq.io
GEMINI_API_KEY=replace-with-authorized-provider-key
# Optional, needed for original voice features:
# OPENAI_API_KEY=
# Optional model overrides:
# GEMINI_IMAGE_MODEL=gemini-3-pro-image
# GEMINI_VOICE_MODEL=gemini-2.5-flash
# Optional, after a new public URL is confirmed:
# PUBLIC_BASE_URL=
# Optional demo integrations; do not reuse old app identifiers blindly:
# SMTP2GO_API_KEY=
# DEMO_SENDER_EMAIL=
# DEMO_SENDER_NAME=FlowGeniQ
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# DEMO_MASTER_NOTIFY_EMAIL=
