# =========================
# Python / Flask .gitignore
# =========================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/
share/python-wheels/
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.ENV/
pythonenv*/
pipenv*/
poetry.lock

# Environment variables / secrets
.env
.env.*
*.env
*.key
*.pem
secrets*.json
instance/
!instance/.gitignore

# Flask stuff
*.log
logs/
flask_session/
.webassets-cache/

# Database files (adjust if you want to keep some)
*.sqlite
*.sqlite3
*.db

# Caches / test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
*.pytest.xml

# Jupyter
.ipynb_checkpoints/

# IDEs / editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Local config overrides
config.local.py
settings.local.py

# Node (if you have frontend assets)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Mac/Windows/Linux temp files
*.swp
*.swo
*~
app.py.backup

# Runtime patient data never belongs in this repository
static/uploads/
static/results/
static/turntable/
static/shares/
static/user_cost_settings.json
!.env.example
# Public design assets are referenced from the existing app in this source-only review.
static/images/favicon.png
static/images/flowmediq-logo.png
static/images/scalp_zones.png
